# The browser talks only to our own backend, which holds every credential
# server-side. Never put database URLs, model endpoints or secrets here.
#
# NEXT_PUBLIC_* values are inlined into the client bundle when the app is
# built, so this only takes effect after a rebuild. The rewrite proxy below
# is read by next.config.js at runtime.
NEXT_PUBLIC_API_BASE=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000

# Secrets — never commit
.env
.env.*
!.env.example
*.pem

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
backend/uploads/

# Node
node_modules/
.next/
frontend/.env*
!frontend/.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Runtime artifacts — never commit
backend/*.log
backend/*.err.log
backend/*token*.txt
backend/login
backend/login.json
backend/ask_resp.json
backend/uv8000*
backend/uploads/
frontend/tsconfig.tsbuildinfo

# Stale artefacts from the earlier AWS-shaped prototype. The platform is
# local-first now: no AWS service is used or referenced anywhere in the code.
AWS_Services_Inventory.docx
Technology_Stack_Inventory.docx
generate_aws_doc.py
generate_stack_doc.py

# Local model caches and downloaded corpora
backend/seed/
backend/.models/

# One-off scratch files from manual probing. These are throwaway diagnostics,
# not part of the application.
backend/*_tmp.py
backend/scripts/_probe*.py
backend/scripts/_*.json
frontend/frontend.log
